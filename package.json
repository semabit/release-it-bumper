{
  "name": "@semabit/release-it-bumper",
  "version": "3.0.1",
  "description": "Version read/write plugin for release-it",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "ava --verbose",
    "release": "release-it",
    "changelog": "auto-changelog",
    "format:check": "prettier --check *.js",
    "format:fix": "prettier --write *.js"
  },
  "keywords": [
    "release",
    "release-it",
    "release-it-plugin",
    "version",
    "bump",
    "manifest"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semabit/release-it-bumper.git"
  },
  "homepage": "https://github.com/semabit/release-it-bumper#readme",
  "author": {
    "email": "lars@webpro.nl",
    "name": "Lars Kappert"
  },
  "dependencies": {
    "detect-indent": "^6.0.0",
    "lodash.castarray": "^4.4.0",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2",
    "mock-fs": "^5.5.0",
    "xml2js": "^0.5.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "auto-changelog": "^1.16.1",
    "ava": "^2.0.0",
    "prettier": "npm:@btmills/prettier@latest",
    "release-it": "^19.2.4",
    "sinon": "^7.3.2"
  },
  "peerDependencies": {
    "release-it": "^19.2.4"
  },
  "resolutions": {
    "@babel/core@^7.5.5": "7.29.6",
    "@babel/traverse@^7.1.0": "7.23.2",
    "@babel/traverse@^7.5.5": "7.23.2",
    "ansi-regex@^3.0.0": "3.0.1",
    "ansi-regex@^4.1.0": "4.1.1",
    "ansi-regex@^5.0.0": "5.0.1",
    "basic-ftp@^5.0.2": "5.3.1",
    "brace-expansion@^1.1.7": "1.1.18",
    "braces@^3.0.1": "3.0.3",
    "braces@^3.0.2": "3.0.3",
    "defu@^6.1.4": "6.1.5",
    "dot-prop@^4.1.0": "4.2.1",
    "dot-prop@^5.1.0": "5.1.1",
    "handlebars@^4.1.2": "4.7.9",
    "ini@^1.3.4": "1.3.6",
    "ini@~1.3.0": "1.3.6",
    "ip-address@^10.0.1": "10.3.1",
    "json5@^2.1.0": "2.2.2",
    "lodash@^4.15.0": "4.18.0",
    "lodash@^4.17.13": "4.18.0",
    "lodash@^4.17.15": "4.18.0",
    "minimatch@^3.0.4": "3.1.4",
    "minimatch@^10.1.2": "10.2.3",
    "minimist@^1.2.0": "1.2.6",
    "node-fetch@^2.6.0": "2.6.7",
    "picomatch@^2.0.4": "2.3.2",
    "picomatch@^2.0.5": "2.3.2",
    "picomatch@^4.0.3": "4.0.4",
    "undici@6.23.0": "6.28.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=8"
  },
  "release-it": {
    "hooks": {
      "before:init": "npm test",
      "after:bump": "auto-changelog --latest-version ${version}"
    },
    "git": {
      "changelog": "auto-changelog --stdout --template ./changelog-template-for-release.hbs",
      "tagArgs": "-s"
    },
    "github": {
      "release": true,
      "releaseName": "${version}",
      "tokenRef": "GITHUB_TOKEN_CLI_RELEASER"
    },
    "npm": {
      "publish": true
    }
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "commitLimit": false,
    "unreleased": true,
    "ignoreCommitPattern": "(Release (v)?|Merge (remote-tracking )?branch)",
    "sortCommits": "date"
  },
  "packageManager": "yarn@4.12.0"
}
